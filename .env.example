# development | test | production
ENVIRONMENT=development

# Optional override. When unset, development uses dish_list and test uses
# dish_list_test. Required when ENVIRONMENT=production.
# DATABASE_URL=postgresql+psycopg://localhost/dish_list

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Frontend API base URL (used by Vite)
VITE_API_BASE_URL=http://localhost:8000
